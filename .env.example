# Copy to .env.local for local overrides. Nothing here is required to build the site.

# Public origin of the site, used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://ozgokceoguz.com

# Only read by `npm run data:github` to refresh content/generated/github.json.
# A token with the read:user scope, or run: GITHUB_TOKEN=$(gh auth token) npm run data:github
GITHUB_TOKEN=

# GitHub account the numbers are read from. Defaults to the username in content/profile.ts.
GITHUB_LOGIN=

# Only for deploying from this machine when GitHub Actions is unavailable:
# `npm run build && npm run deploy:dry` lists the changes, `npm run deploy:live` uploads them.
# In CI the same values come from the repository secrets HOSTINGER_FTP_*.
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
