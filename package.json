    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "react": "~19.3",
    "react-aria-components": "^1.22.1",
    "react-dom": "~19.3",
    "tailwind-variants": "^4.0.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@samkirkland/ftp-deploy": "^1.2.5",
